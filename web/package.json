{
  "name": "clinker-rust-web",
  "private": true,
  "scripts": {
    "build": "sh build.sh",
    "package": "node scripts/package.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "check:assets": "node scripts/sync-assets.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:wasm": "node --test tests/wasm/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "build:viewer": "node scripts/build-viewer.mjs"
  },
  "dependencies": {
    "clustermap.js": "https://codeload.github.com/gamcil/clustermap.js/tar.gz/844e249ec97b8927d3f737025b4674329f8e8d28",
    "d3": "7.9.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
